<?xml version="1.0" encoding="UTF-8"?>
<FTL>
<!--
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
	JUKEBOX
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
-->
<mod:findName type="event" name="STORAGE_CHECK_JUKEBOX">
	<mod:findLike type="choice" start="1" limit="1">
		<mod:findLike type="event">
			<mod-append:variable name="fish_music" op="set" val="0"/>
		</mod:findLike>
	</mod:findLike>

	<mod-append:choice hidden="true" blue="true">
		<text>Fishing: Fishing Music</text>
		<event>
			<variable name="fish_music" op="set" val="1"/>
			<playMusic>fishmusic</playMusic>
			<loadEvent>STORAGE_CHECK_JUKEBOX</loadEvent>
		</event>
	</mod-append:choice>
	
	<mod-append:choice hidden="true" blue="true">
		<text>Bass Fishing: Lodge Area</text>
		<event>
			<playMusic>lodge_area</playMusic>
			<loadEvent>STORAGE_CHECK_JUKEBOX</loadEvent>
		</event>
	</mod-append:choice>
</mod:findName>
	
	<mod-append:choice hidden="true" blue="true">
		<text>Bass Fishing: Inlet Area</text>
		<event>
			<playMusic>inlet_area</playMusic>
			<loadEvent>STORAGE_CHECK_JUKEBOX</loadEvent>
		</event>
	</mod-append:choice>
</mod:findName>
	
	<mod-append:choice hidden="true" blue="true">
		<text>Bass Fishing: Bridge Area</text>
		<event>
			<playMusic>bridge_area</playMusic>
			<loadEvent>STORAGE_CHECK_JUKEBOX</loadEvent>
		</event>
	</mod-append:choice>
</mod:findName>

<event name="FISH_END_MUSIC">
	<playMusic />
</event>
</FTL>