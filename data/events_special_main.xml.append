  <mod:findLike type="eventButton">
    <mod:selector name="ADDON_AA"/>
    <mod:removeTag/>
  </mod:findLike>
  <mod:findLike type="eventButton">
    <mod:selector name="ADDON_PIP"/>
    <mod:removeTag/>
  </mod:findLike>
  <mod:findLike type="eventButton">
    <mod:selector name="ADDON_TCC"/>
    <mod:removeTag/>
  </mod:findLike>
  <mod:findLike type="eventButton">
    <mod:selector name="ADDON_RAD"/>
    <mod:removeTag/>
  </mod:findLike>
</mod:findName>

</FTL>

