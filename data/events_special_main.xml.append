<mod:findName type="event" name="START_BEACON_PREP_OPTIONS">
		<mod-append:choice hidden="true" req="FISH_WEIGHT_RECORD_TOTAL" lvl="16000" blue="false">
        <text>Visit the fish locker.</text>
        <event>
            <text>Grab a fish from the collection of previous renegades.</text>
            <choice hidden="true" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="16000" max_lvl="48000">
                <text>[Rookie] Get a fish.</text>
                <event>
                    <weapon name="FISHLIST_1" />
                    <text>You present your fishing credentials to the crustodeans.  "Alright slugger, one fish coming up!"</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="48000">
                <text>[Rookie] Get a fish.</text>
                <event>
                    <weapon name="FISHLIST_1" />
                    <text>You present your fishing credentials to the crustodeans.  "Alright slugger, one fish coming up!"</text>
                </event>
            </choice>
            <choice hidden="true" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="32000" max_lvl="128000">
                <text>[Challenger] Get a big fish.</text>
                <event>
                    <weapon name="FISHLIST_2" />
                    <text>You present your fishing credentials to the crustodeans.  "You got it boss, here's your fish!"</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="128000">
                <text>[Challenger] Get a big fish.</text>
                <event>
                    <weapon name="FISHLIST_2" />
                    <text>You present your fishing credentials to the crustodeans.  "You got it boss, here's your fish!"</text>
                </event>
            </choice>
            <choice hidden="true" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="80000" max_lvl="240000">
                <text>[Master] Get a huge fish.</text>
                <event>
                    <weapon name="FISHLIST_3" />
                    <text>You present your fishing credentials to the crustodeans.  "Whoa, alright!  Hey fellas, pull out the big ones!"</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="240000">
                <text>[Master] Get a huge fish.</text>
                <event>
                    <weapon name="FISHLIST_3" />
                    <text>You present your fishing credentials to the crustodeans.  "Whoa, alright!  Hey fellas, pull out the big ones!"</text>
                </event>
            </choice>
            <choice hidden="true" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="160000" max_lvl="960000">
                <text>[Grand Master] Get a legendary fish.</text>
                <event>
                    <weapon name="FISHLIST_LEG" />
                    <text>You present your fishing credentials to the crustodeans.  "Well now that's not something you see every day." He nods. "Your items will be beamed abord presently."</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="960000">
                <text>[Grand Master] Get a legendary fish.</text>
                <event>
                    <weapon name="FISHLIST_LEG" />
                    <text>You present your fishing credentials to the crustodeans.  "Well now that's not something you see every day." He nods. "Your items will be beamed abord presently."</text>
                </event>
            </choice>
            <choice hidden="true" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="24000" max_lvl="120000">
                <text>[Professional] Get a fish gun.</text>
                <event>
                    <weapon name="FISHLIST_GUNS" />
                    <text>You present your fishing credentials to the crustodeans.  Eyes glinting, they hand you a gunfish. "I see you're a renegade of fine taste! You gotta tell me how it does for you after you take it for a spin."</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="120000">
                <text>[Professional] Get a fish gun.</text>
                <event>
                    <weapon name="FISHLIST_GUNS" />
                    <text>You present your fishing credentials to the crustodeans.  Eyes glinting, they hand you a gunfish. "I see you're a renegade of fine taste! You gotta tell me how it does for you after you take it for a spin."</text>
                </event>
            </choice>
            <choice hidden="false" blue="false" req="FISH_WEIGHT_RECORD_TOTAL" lvl="1600000">
                <text>[Fish Lord] Take your pick of everything.</text>
                <event>
                    <text>You stride into the Hall of Fish, clearing the security checkpoint with a flash of your cod-tier fishing creds.</text>
                    <choice hidden="true" blue="false">
                        <text>Continue...</text>
                        <event load="FISH_CHOOSE_ANY"/>
                    </choice>
                </event>
            </choice>
        </event>
    </mod-append:choice>
</mod:findName>


